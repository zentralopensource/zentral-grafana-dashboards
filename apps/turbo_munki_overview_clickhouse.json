                        "pluginVersion": "4.18.0",
                        "queryType": "timeseries",
                        "rawSql": "SELECT\n    $__timeInterval(created_at) AS time,\n    least(100, round(100 * countIf(fam = 'turbo' AND rt = 'postflight')\n              / nullIf(countIf(fam = 'turbo' AND rt = 'job_details'), 0), 2)) AS turbo,\n    least(100, round(100 * countIf(fam = 'scripts' AND rt = 'postflight')\n              / nullIf(countIf(fam = 'scripts' AND rt = 'job_details'), 0), 2)) AS legacy\nFROM (\n    SELECT\n        created_at,\n        multiIf(metadata.request.user_agent.:String LIKE 'turbo/%', 'turbo',\n                metadata.request.user_agent.:String LIKE 'Zentral/munki%', 'scripts',\n                'other') AS fam,\n        payload.request_type.:String AS rt\n    FROM zentral.zentral_events\n    WHERE type = 'munki_request' AND $__timeFilter(created_at)\n)\nGROUP BY time\nORDER BY time"
                      }
                    },
