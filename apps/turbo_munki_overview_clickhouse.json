      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Broken machines",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "WITH\nturbo_window AS (\n    SELECT\n        serial_number,\n        created_at,\n        metadata.request.user_agent.:String AS version,\n        payload.request_type.:String AS rt\n    FROM zentral.zentral_events\n    WHERE type = 'munki_request'\n      AND $__timeFilter(created_at)\n      AND metadata.request.user_agent.:String LIKE 'turbo/%'\n),\nbroken AS (\n    SELECT\n        serial_number,\n        argMax(version, created_at) AS turbo_version,\n        countIf(rt = 'job_details') AS preflights,\n        max(created_at) AS last_preflight\n    FROM turbo_window\n    GROUP BY serial_number\n    HAVING countIf(rt = 'postflight') = 0 AND preflights > 0\n),\nhistory AS (\n    SELECT\n        serial_number,\n        maxIf(created_at, payload.request_type.:String = 'postflight') AS last_postflight,\n        minIf(created_at, metadata.request.user_agent.:String LIKE 'turbo/%') AS first_turbo_request\n    FROM zentral.zentral_events\n    WHERE type = 'munki_request'\n      AND serial_number IN (SELECT serial_number FROM broken)\n    GROUP BY serial_number\n)\nSELECT\n    b.serial_number AS serial_number,\n    b.turbo_version AS turbo_version,\n    b.preflights AS preflights_with_no_report,\n    b.last_preflight AS last_preflight,\n    h.first_turbo_request AS turbo_first_seen,\n    if(h.last_postflight = toDateTime64(0, 9, 'UTC'), NULL, h.last_postflight) AS last_good_report,\n    if(h.last_postflight = toDateTime64(0, 9, 'UTC'), NULL,\n       dateDiff('day', h.last_postflight, now())) AS days_stale,\n    multiIf(h.last_postflight = toDateTime64(0, 9, 'UTC'), 'never reported',\n            dateDiff('day', h.last_postflight, h.first_turbo_request) <= 1, 'broke at turbo install',\n            'already stale before turbo') AS classification\nFROM broken b\nLEFT JOIN history h USING (serial_number)\nORDER BY days_stale DESC NULLS LAST"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
