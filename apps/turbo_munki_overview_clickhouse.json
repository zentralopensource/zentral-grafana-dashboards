      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Broken turbo enrollment",
          "description": "If number or req/day on enrollment endpoint per machine > as other versions, then enrollment issue",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "WITH machines_per_version AS (\n    SELECT\n        metadata.request.user_agent.:String AS version,\n        uniqExact(serial_number) AS machines\n    FROM zentral.zentral_events\n    WHERE type = 'munki_request'\n      AND $__timeFilter(created_at)\n      AND metadata.request.user_agent.:String LIKE 'turbo/%'\n    GROUP BY version\n)\nSELECT\n    e.version AS version,\n    m.machines AS machines,\n    e.requests AS requests,\n    round(e.requests / nullIf(m.machines, 0)\n          / greatest(dateDiff('day', $__fromTime, $__toTime), 1), 2) AS reqs_per_machine_per_day\nFROM (\n    SELECT metadata.request.user_agent.:String AS version, count() AS requests\n    FROM zentral.zentral_events\n    WHERE type = 'enrollment_info_request'\n      AND $__timeFilter(created_at)\n      AND metadata.request.user_agent.:String LIKE 'turbo/%'\n    GROUP BY version\n) e\nLEFT JOIN machines_per_version m USING (version)\nORDER BY reqs_per_machine_per_day DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "requests"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 107
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
