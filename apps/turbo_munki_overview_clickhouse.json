                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    serial_number,\n    argMaxIf(ua, created_at, ua LIKE 'turbo/%') AS turbo_version,\n    countIf(ua LIKE 'turbo/%') AS turbo_requests,\n    countIf(ua LIKE 'Zentral/munki%') AS legacy_requests,\n    maxIf(created_at, ua LIKE 'Zentral/munki%') AS last_legacy_request\nFROM (\n    SELECT serial_number, created_at, metadata.request.user_agent.:String AS ua\n    FROM zentral.zentral_events\n    WHERE type = 'munki_request' AND $__timeFilter(created_at)\n)\nGROUP BY serial_number\nHAVING turbo_requests > 0 AND legacy_requests > 0\nORDER BY legacy_requests DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
