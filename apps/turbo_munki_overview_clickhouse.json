                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.18.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    multiIf(days_stale IS NULL, '6 never reported',\n            days_stale <= 1,    '1 fresh (<=1d)',\n            days_stale <= 3,    '2 2-3d',\n            days_stale <= 7,    '3 4-7d',\n            days_stale <= 30,   '4 8-30d',\n                                '5 >30d') AS staleness,\n    count() AS machines\nFROM (\n    SELECT\n        t.serial_number AS serial_number,\n        if(p.last_postflight = toDateTime64(0, 9, 'UTC'), NULL,\n           dateDiff('day', p.last_postflight, now())) AS days_stale\n    FROM (\n        SELECT DISTINCT serial_number\n        FROM zentral.zentral_events\n        WHERE type = 'munki_request'\n          AND $__timeFilter(created_at)\n          AND metadata.request.user_agent.:String LIKE 'turbo/%'\n    ) t\n    LEFT JOIN (\n        SELECT serial_number, max(created_at) AS last_postflight\n        FROM zentral.zentral_events\n        WHERE type = 'munki_request'\n          AND payload.request_type.:String = 'postflight'\n        GROUP BY serial_number\n    ) p USING (serial_number)\n)\nGROUP BY staleness\nORDER BY staleness"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
